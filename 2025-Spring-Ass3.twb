    <dashboard name='Storyboard ElecMachine' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>The Electrical Machinery Sector: Growth, Structure, and Momentum</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='512' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98002' id='7' param='vert' removable='false' type-v2='layout-flow' w='99034' x='483' y='999'>
            <zone h='6242' id='8' type-v2='title' w='99034' x='483' y='999'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='91760' id='1' param='vert' removable='false' type-v2='layout-flow' w='99034' x='483' y='7241'>
              <zone fixed-size='140' h='17478' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99034' x='483' y='7241' />
              <zone h='74282' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99034' x='483' y='24719'>
                <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Machinery Imports consistently outpace Exports. Raw data confirms the long-term upward growth trend since 1990. The change is substantial in both however it is clear that every sub-category including Electrical Machinery assist in the upward trend.' captured-sheet='ElecMachine-Raw (2)' id='4' />
                    <story-point caption='Electrical Machinery maintains a stable, high share of total trade (Statistical) even though it isn&apos;t the largest contributor. Its resilience confirms it as a non-volatile, structurally embedded economic component.' captured-sheet='ElecMachine-Sta (2)' id='5'>
                      <capturedDeltas>
                        <worksheet name='ElecMachine-Sta (2)'>
                          <style delta-type='added'>
                            <style-rule element='axis'>
                              <encoding attr='space' class='0' field='[federated.1daqd2411yscbx12o40vb0wm0k1c].[none:Calculation_415738542537617409:qk]' field-type='quantitative' max='2024' min='1989' range-type='fixed' scope='cols' type='space' />
                            </style-rule>
                          </style>
                          <selection-collection />
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Subcat 77&apos;s YoY growth (Analytical) mirrors its Main Category 7. The close alignment of their lines around the 1.0 baseline proves that Subcat 77&apos;s momentum is the defining factor for the entire Machinery sector&apos;s annual performance.' captured-sheet='ElecMachine-Ana (2)' id='6'>
                      <capturedDeltas>
                        <worksheet name='ElecMachine-Ana (2)'>
                          <style delta-type='added'>
                            <style-rule element='axis'>
                              <encoding attr='space' class='0' field='[federated.1daqd2411yscbx12o40vb0wm0k1c].[none:Calculation_415738542537617409:qk]' field-type='quantitative' max='2024' min='1989' range-type='fixed' scope='cols' type='space' />
                            </style-rule>
                          </style>
                          <selection-collection />
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{8C58FF2D-DF9F-4B19-B39F-487A78469AE5}' />
    </dashboard>
